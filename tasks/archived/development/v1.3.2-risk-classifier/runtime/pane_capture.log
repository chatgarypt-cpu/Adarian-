   60 _SYSTEM_PROMPT = (
   61     "You are a risk classification expert for a government governance "
   62     "simulation system.\n"
   63     "You will receive a compressed summary of a simulated public opinion event.\n"
   64     "You will also receive a catalog of 26 risk types with brief descriptions.\n"
   65     "Your task: select the top 3 most applicable risk types for this event.\n"
   66     "Output ONLY valid type IDs from the catalog. Do not invent new types.\n"
   67     "Output exactly 3 types, ordered by relevance (most relevant first).\n"
   68     "Return a JSON object with a 'primary_types' array."
   69 )
   70
   71 # How many of the latest active speakers to surface as representative comments.
   72 _NUM_RECENT_COMMENTS = 4
   73 _TICKS_TO_SCAN_FOR_COMMENTS = 3
   74 _COMMENT_MAX_CHARS = 80
   75
   76
   77 class RiskClassifier:
   78     """Compresses simulation data and asks the LLM to pick Top-3 risk types."""
   79
   80     # ------------------------------------------------------------------
   81     # Query text construction
   82     # ------------------------------------------------------------------
   83
   84     @staticmethod
   85     def _format_metric(value: Any, fmt: str = ".2f") -> str:
   86         if value is None:
   87             return "n/a"
   88         try:
   89             return format(value, fmt)
   90         except (TypeError, ValueError):
   91             return str(value)
   92
   93     def _pick_representative_comments(
   94         self, tick_logs: List[TickLog],
   95     ) -> List[Dict[str, Any]]:
   96         """Pick up to 3-5 active speakers from the final 2-3 ticks.
   97
   98         Selection rules (in order of preference, then by tick descending):
   99         1. Active speaker in the most recent tick.
  100         2. Sort by stance_score absolute deviation from the final mean (most
  101            diagnostic of polarized voices).
  102         3. Deduplicate by (group_name, comment prefix).
  103         """
  104         if not tick_logs:
  105             return []
  106
  107         recent = tick_logs[-_TICKS_TO_SCAN_FOR_COMMENTS:]
  108         final_mean = tick_logs[-1].global_metrics.mean_stance
  109
  110         candidates: List[Dict[str, Any]] = []
  111         seen: set = set()
  112         for tl in reversed(recent):
  113             for entry in tl.entries:
  114                 if entry.speaker_status != "active":
  115                     continue
  116                 if not entry.comment:
  117                     continue
  118                 dedup_key = (entry.group_name, entry.comment[:30])
  119                 if dedup_key in seen:
  120                     continue
  121                 seen.add(dedup_key)
  122                 candidates.append({
  123                     "tick": tl.tick,
  124                     "group_name": entry.group_name,
  125                     "stance_score": entry.current_stance,
  126                     "stance_deviation": abs(entry.current_stance - final_mean),
  127                     "comment": entry.comment,
  128                 })
  129
  130         candidates.sort(
  131             key=lambda c: (c["stance_deviation"], c["tick"]),
  132             reverse=True,
  133         )
  134         return candidates[:_NUM_RECENT_COMMENTS]
  135
  136     def _build_query_text(
  137         self,
  138         extraction_output: EntityExtractionOutput,
  139         tick_logs: List[TickLog],
  140         x_t_sequence: List[float],
  141         simulation_result: Dict[str, Any],
  142     ) -> str:
  143         """Compress simulation data into a stable query text (~400-500 tokens)."""
  144         # --- Event header ---
  145         event_lines: List[str] = [
  146             "[Event]",
  147             f"name: {extraction_output.event_summary}",
  148             f"type: {extraction_output.event_type}",
  149             f"scale: {self._format_metric(extraction_output.event_scale, '.2f')}",
  150             f"controversy: {self._format_metric(extraction_output.event_controversy, '.2f')}",
  151         ]
  152
  153         risk_verdict = simulation_result.get("risk_verdict", {}) or {}
  154         event_lines.append(
  155             f"risk_level: {risk_verdict.get('label') or risk_verdict.get('level') or 'n/a'}"
  156         )
  157
  158         # --- Key entities (name + type + role) ---
  159         entity_lines = ["[Key Entities]"]
  160         for ent in extraction_output.event_entities[:8]:
  161             entity_lines.append(
  162                 f"- {ent.name} | {ent.type} | role={ent.role}"
  163             )
  164         if len(extraction_output.event_entities) > 8:
  165             entity_lines.append(
  166                 f"- ... +{len(extraction_output.event_entities) - 8} more"
  167             )
  168
  169         # --- Key groups with final stance + max delta ---
  170         stance_matrix = simulation_result.get("agent_stance_matrix") or []
  171         group_lines = ["[Key Groups]"]
  172         if stance_matrix:
  173             sorted_rows = sorted(
  174                 stance_matrix,
  175                 key=lambda r: r.get("max_delta", 0) if isinstance(r, dict) else 0,
  176                 reverse=True,
  177             )[:6]
  178             for row in sorted_rows:
  179                 if not isinstance(row, dict):
  180                     continue
  181                 group_lines.append(
  182                     f"- {row.get('group_name', '?')} | "
  183                     f"final={self._format_metric(row.get('final_stance'), '.1f')} | "
  184                     f"max_delta={self._format_metric(row.get('max_delta'), '.2f')}"
  185                 )
  186         else:
  187             group_lines.append("- (no agent_stance_matrix)")
  188
  189         # --- Representative comments ---
  190         comment_lines = ["[Representative Comments]"]
  191         rep_comments = self._pick_representative_comments(tick_logs)
  192         if rep_comments:
  193             for c in rep_comments:
  194                 txt = (c["comment"] or "").strip().replace("\n", " ")
  195                 if len(txt) > _COMMENT_MAX_CHARS:
  196                     txt = txt[: _COMMENT_MAX_CHARS - 1] + "…"
  197                 comment_lines.append(
  198                     f"- tick={c['tick']} {c['group_name']} "
  199                     f"(stance={self._format_metric(c['stance_score'], '.1f')}): {txt}"
  200                 )
  201         else:
  202             comment_lines.append("- (no active comments in final ticks)")
  203
  204         # --- Metrics ---
  205         final_x = x_t_sequence[-1] if x_t_sequence else None
  206         start_x = x_t_sequence[0] if x_t_sequence else None
  207         negative_trend = (
  208             max(0.0, start_x - final_x)
  209             if (start_x is not None and final_x is not None and len(x_t_sequence) > 1)
  210             else 0.0
  211         )
  212         final_pol = (
  213             tick_logs[-1].global_metrics.polarization_index if tick_logs else None
  214         )
  215         # max_negative_shift from stance matrix
  216         max_neg_shift = 0.0
  217         if stance_matrix:
  218             for row in stance_matrix:
  219                 if not isinstance(row, dict):
  220                     continue
  221                 init = row.get("initial_stance")
  222                 final = row.get("final_stance")
  223                 if init is None or final is None:
  224                     continue
  225                 max_neg_shift = max(max_neg_shift, max(0.0, init - final))
  226
  227         metric_lines = [
  228             "[Metrics]",
  229             f"final_x (mean stance): {self._format_metric(final_x, '.2f')}",
  230             f"final_polarization_index: {self._format_metric(final_pol, '.2f')}",
  231             f"negative_trend: {self._format_metric(negative_trend, '.2f')}",
  232             f"max_negative_shift: {self._format_metric(max_neg_shift, '.2f')}",
  233         ]
  234
  235         return "\n".join(
  236             event_lines + [""] + entity_lines + [""] + group_lines + [""] +
  237             comment_lines + [""] + metric_lines
  238         )
  239
  240     # ------------------------------------------------------------------
  241     # Type catalog construction
  242     # ------------------------------------------------------------------
  243
  244     def _build_type_catalog(self) -> str:
  245         """Build the 26-type catalog — one line per type.
  246
  247         Format: `<type_id>: <label> | <domain_label> | <typical_scenario>`
  248         """
  249         lines: List[str] = []
  250         for type_id, domain_id in TYPE_TO_DOMAIN_MAP.items():
  251             label = RISK_TYPE_LABELS.get(type_id, type_id)
  252             domain_label = DOMAIN_LABELS.get(domain_id, domain_id)
  253             scenario = _TYPE_SCENARIOS.get(type_id, "")
  254             lines.append(f"{type_id}: {label} | {domain_label} | {scenario}")
  255         return "\n".join(lines)
  256
  257     # ------------------------------------------------------------------
  258     # LLM call
  259     # ------------------------------------------------------------------
  260
  261     @staticmethod
  262     def _validate_primary_types(primary_types: List[str]) -> None:
  263         if len(primary_types) != 3:
  264             raise ValueError(
  265                 f"primary_types must contain exactly 3 entries, got {len(primary_types)}: "
  266                 f"{primary_types}"
  267             )
  268         if len(set(primary_types)) != 3:
  269             raise ValueError(f"primary_types contains duplicates: {primary_types}")
  270         invalid = [t for t in primary_types if t not in RISK_TYPE_LABELS]
  271         if invalid:
  272             raise ValueError(f"primary_types contains unknown risk types: {invalid}")
  273         # Also require them to be in the 26-type taxonomy (not the legacy 13).
  274         invalid_legacy = [t for t in primary_types if t not in TYPE_TO_DOMAIN_MAP]
  275         if invalid_legacy:
  276             raise ValueError(
  277                 f"primary_types contains legacy/non-26-type IDs: {invalid_legacy}. "
  278                 f"RiskClassifier only emits types from the 26-type taxonomy."
  279             )
  280
  281     def classify(
  282         self,
  283         extraction_output: EntityExtractionOutput,
  284         tick_logs: List[TickLog],
  285         x_t_sequence: List[float],
  286         simulation_result: Dict[str, Any],
  287     ) -> ClassificationOutput:
  288         """Build query text → call LLM → parse response → validate.
  289
  290         The LLM is called as `caller="classify"`, which the TokenTracker maps to
  291         the "Phase 3 Parser" phase.
  292         """
  293         query_text = self._build_query_text(
  294             extraction_output, tick_logs, x_t_sequence, simulation_result
  295         )
  296         catalog = self._build_type_catalog()
  297
  298         user_prompt = (
  299             "You are given a compressed summary of a simulated public opinion "
  300             "event and a catalog of 26 risk types. Select the top 3 most "
  301             "applicable risk types for this event.\n\n"
  302             "### Event Summary\n"
  303             f"{query_text}\n\n"
  304             "### Risk Type Catalog (26 types)\n"
  305             f"{catalog}\n\n"
  306             "Select exactly 3 risk types from the catalog above.\n"
  307             "Output as JSON: {\"primary_types\": [\"type_id_1\", "
  308             "\"type_id_2\", \"type_id_3\"]}"
  309         )
  310
  311         llm = get_llm_client()
  312         result = llm.generate(
  313             system=_SYSTEM_PROMPT,
  314             user=user_prompt,
  315             response_model=ClassificationOutput,
  316         )
  317
  318         # Defensive validation — LLMClient already validates via Pydantic, but
  319         # we also enforce the 26-type taxonomy constraint here.
  320         self._validate_primary_types(result.primary_types)
  321         return result
  322
  323
