  346         console.print("[bold red]错误：[/bold red] 未配置 LLM API Key")
  347         console.print("请创建 .env 文件或设置环境变量 LLM_API_KEY")
  348         sys.exit(1)
  349
  350     # 初始化 LLM 客户端
  351     init_llm_client()
  352     console.print(f"[green]OK[/green] LLM: {config.LLM_PROVIDER} / {config.get_model_name()}\n")
  353
  354     # 加载种子文本
  355     if len(sys.argv) > 1:
  356         seed_file = Path(sys.argv[1])
  357     else:
  358         seed_file = config.SEEDS_DIR / "example_event.txt"
  359
  360     if not seed_file.exists():
  361         console.print(f"[bold red]错误：[/bold red] 种子文件不存在: {seed_file}")
  362         sys.exit(1)
  363
  364     seed_file = seed_file.resolve()
  365     run_context = build_run_paths(seed_file)
  366     run_dir = run_context["run_dir"]
  367     outputs = run_context["outputs"]
  368     started_at = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
  369     write_run_meta(run_context, seed_file, status="running", started_at=started_at)
  370
  371     logger = get_runtime_logger()
  372     logger.configure(run_dir)
  373     logger.log_run_start("normal", str(seed_file), str(run_dir))
  374
  375     console.print(f"种子文件: {seed_file.name}\n")
  376     console.print(f"运行目录: {run_dir}\n")
  377
  378     with open(seed_file, "r", encoding="utf-8") as f:
  379         seed_text = f.read()
  380
  381     # 计时
  382     start_time = time.time()
  383
  384     try:
  385         # Phase 1: 实体提取与分类（Analyzer/Generator/Validator 协作）
  386         logger.log_phase_start("phase1_entity_extraction")
  387         phase1_start = time.time()
  388         extraction_output, entities_file = run_phase1(str(seed_file), output_path=outputs["entities"])
  389         phase1_time = time.time() - phase1_start
  390         logger.log_phase_end("phase1_entity_extraction", phase1_time)
  391
  392         # Phase 2: 社交拓扑构建
  393         logger.log_phase_start("phase2_topology_builder")
  394         phase2_start = time.time()
  395         phase2_output = run_phase2(extraction_output, output_path=outputs["social_graph"])
  396         phase2_time = time.time() - phase2_start
  397         logger.log_phase_end("phase2_topology_builder", phase2_time)
  398
  399         # Phase 3: 多轮涌现推演
  400         logger.log_phase_start("phase3_tick_simulation")
  401         phase3_start = time.time()
  402         tick_logs, x_t_sequence = run_phase3(
  403             extraction_output,
  404             phase2_output,
  405             seed_text,
  406             output_path=outputs["tick_logs"],
  407         )
  408         phase3_time = time.time() - phase3_start
  409         logger.log_phase_end("phase3_tick_simulation", phase3_time)
  410
  411         # Phase 4: 宏观洞察生成
  412         logger.log_phase_start("phase4_report_agent")
  413         phase4_start = time.time()
  414         phase4_output = run_phase4(
  415             extraction_output,
  416             phase2_output,
  417             tick_logs,
  418             x_t_sequence,
  419             json_output_path=outputs["final_report_json"],
  420             markdown_output_path=outputs["final_report_md"],
  421         )
  422         phase4_time = time.time() - phase4_start
  423         logger.log_phase_end("phase4_report_agent", phase4_time)
  424
  425         # 总耗时
  426         total_time = time.time() - start_time
  427         logger.log_run_end("success", total_time)
  428         write_run_meta(
  429             run_context,
  430             seed_file,
  431             status="success",
  432             started_at=started_at,
  433             completed_at=datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
  434             elapsed_seconds=round(total_time, 2),
  435             x_t_sequence=x_t_sequence,
  436             final_polarization_index=tick_logs[-1].global_metrics.polarization_index,
  437             risk_level=phase4_output.risk_level.value,
  438         )
  439         whitebox_artifacts = write_whitebox_artifacts(run_context)
  440         report_completeness = whitebox_artifacts["report_completeness"]["result"]
  441
