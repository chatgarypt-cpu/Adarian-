  218 def build_run_paths(seed_file: Path) -> dict:
  219     """Create the run directory and return all authoritative output paths."""
  220     now = datetime.now()
  221     batch_id = f"{seed_file.stem}_{now.strftime('%Y%m%d_%H%M%S')}"
  222     run_id = f"run_{now.strftime('%f')}_{os.getpid()}"
  223     batch_dir = config.OUTPUTS_DIR / "runs" / batch_id
  224     batch_dir.mkdir(parents=True, exist_ok=True)
  225     run_dir = batch_dir / run_id
  226     run_dir.mkdir(parents=True, exist_ok=False)
  227     whitebox_dir = run_dir / "whitebox"
  228     whitebox_dir.mkdir(parents=True, exist_ok=True)
  229
  230     seed_copy = run_dir / "seed_input.txt"
  231     shutil.copyfile(seed_file, seed_copy)
  232
  233     outputs = {
  234         "entities": run_dir / "entities_and_relations.json",
  235         "social_graph": run_dir / "social_graph.json",
  236         "tick_logs": run_dir / "tick_logs.json",
  237         "final_report_json": run_dir / "final_report.json",
  238         "final_report_md": run_dir / "final_report.md",
  239         "whitebox_summary": run_dir / "whitebox_summary.json",
  240         "whitebox_dir": whitebox_dir,
  241         "run_log": run_dir / "run.log",
  242         "timing_summary": run_dir / "timing_summary.json",
  243         "run_meta": run_dir / "run_meta.json",
  244     }
  245
  246     return {
  247         "batch_id": batch_id,
  248         "batch_dir": batch_dir,
  249         "run_id": run_id,
  250         "run_dir": run_dir,
  251         "seed_copy": seed_copy,
  252         "outputs": outputs,
  253     }
  254
  255
  256 def write_run_meta(run_context: dict, seed_file: Path, status: str, started_at: str, **extra) -> None:
  257     """Write run metadata for replay and acceptance checks."""
  258     outputs = run_context["outputs"]
  259     payload = {
  260         "batch_id": run_context.get("batch_id"),
  261         "batch_dir": str(run_context.get("batch_dir")) if run_context.get("batch_dir") else None,
  262         "run_id": run_context["run_id"],
  263         "seed_file": str(seed_file),
  264         "seed_copy": str(run_context["seed_copy"]),
  265         "run_dir": str(run_context["run_dir"]),
  266         "started_at": started_at,
  267         "provider": config.LLM_PROVIDER,
  268         "model": config.get_model_name(),
  269         "status": status,
  270         "outputs": {key: str(path) for key, path in outputs.items()},
  271     }
  272     payload.update(extra)
  273
  274     with open(outputs["run_meta"], "w", encoding="utf-8") as f:
  275         json.dump(payload, f, ensure_ascii=False, indent=2)
  276
  277
  278 def write_whitebox_summary(
  279     run_context: dict,
  280     report_completeness: dict,
  281     artifact_check: dict,
  282 ) -> dict:
  283     """Write the top-level whitebox summary as an index plus status."""
  284     outputs = run_context["outputs"]
  285     checks = {
  286         "report_completeness": {
  287             "status": report_completeness["status"],
  288             "path": report_completeness["path"],
  289         },
  290         "artifact_check": {
  291             "status": artifact_check["status"],
  292             "path": artifact_check["path"],
  293         },
  294     }
  295
  296     if artifact_check["status"] != "pass":
  297         status = "fail"
  298     elif report_completeness["status"] != "pass":
  299         status = "pass_with_warnings"
  300     else:
  301         status = "pass"
  302
  303     payload = {
  304         "whitebox_version": "v1.2.5",
  305         "status": status,
  306         "checks": checks,
  307         "raw_sources": artifact_check["raw_sources"],
  308     }
  309
  310     with open(outputs["whitebox_summary"], "w", encoding="utf-8") as f:
  311         json.dump(payload, f, ensure_ascii=False, indent=2)
  312
  313     return payload
