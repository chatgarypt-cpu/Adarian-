  206 ## 5. 建议的可执行验证（注入到 §2.7）
  207
  208 下面三个脚本可直接用于 plan §2.7 / §2.6 Step 9-10：
  209
  210 ### 5.1 Field Provenance Check（注入 §2.7 #3）
  211
  212 ```python
  213 #!/usr/bin/env python3
  214 """Verify §2.7 #3: report fields come from simulation_dataset."""
  215 import json, sys, subprocess, os, glob, time, importlib
  216
  217 # 1. Run the pipeline
  218 seed = sys.argv[1] if len(sys.argv) > 1 else 'seeds/test8.txt'
  219 result = subprocess.run(
  220     ['.venv/bin/python', 'main.py', seed],
  221     capture_output=True, text=True
  222 )
  223 assert result.returncode == 0, f'main.py exited {result.returncode}: {result.stderr[:500]}'
  224
  225 # 2. Locate simulation_dataset.json
  226 import config
  227 sim_path = getattr(config, 'SIMULATION_DATASET_PATH', None)
  228 if sim_path is None:
  229     candidates = sorted(
  230         glob.glob('outputs/run_*/simulation_dataset.json'),
  231         key=os.path.getmtime, reverse=True
  232     )
  233     assert candidates, 'No simulation_dataset.json found under outputs/run_*'
  234     sim_path = candidates[0]
  235 run_dir = os.path.dirname(sim_path)
  236
  237 # 3. Load both
  238 with open(sim_path) as f:
  239     dataset = json.load(f)
  240 with open(os.path.join(run_dir, 'final_report.json')) as f:
  241     report = json.load(f)
  242
  243 # 4. Field provenance assertions
  244 # (a) risk_level
  245 assert report['risk_level'] == dataset['simulation_result']['risk_verdict']['level'], (
  246     f"risk_level mismatch: report={report['risk_level']} "
  247     f"vs dataset={dataset['simulation_result']['risk_verdict']['level']}"
  248 )
  249
  250 # (b) inflection_points: structural equality
  251 report_pts = report['inflection_points']
  252 sim = dataset['simulation_result']
  253 dataset_pts = sim.get('inflection_points', [])
  254 assert len(report_pts) == len(dataset_pts), (
  255     f'Inflection point count mismatch: {len(report_pts)} vs {len(dataset_pts)}'
  256 )
  257 for r, d in zip(report_pts, dataset_pts):
  258     assert r['tick'] == d['tick'], f'Tick mismatch: {r} vs {d}'
  259     assert r['agent_id'] == d['agent_id'], f'Agent id mismatch: {r} vs {d}'
  260
  261 # (c) agent_stance_matrix
  262 report_matrix = report['agent_stance_matrix']
  263 dataset_matrix = sim.get('agent_stance_matrix', [])
  264 assert len(report_matrix) == len(dataset_matrix), 'Stance matrix agent count mismatch'
  265 for r, d in zip(report_matrix, dataset_matrix):
  266     assert r['agent_id'] == d['agent_id'], f'Agent id mismatch: {r} vs {d}'
  267
  268 print('OK: field provenance check passed')
  269 ```
  270
  271 ### 5.2 No-Legacy-Compute Runtime Check（注入 §2.7 #4 之后作为 #6）
  272
  273 ```python
  274 """tests/test_phase4_no_legacy_compute_at_runtime.py
  275 Runtime check: main pipeline does not call any legacy compute function.
  276 """
  277 import subprocess, os
  278
  279 LEGACY_NAMES = [
  280     'assess_risk',
  281     'identify_inflection_points',
  282     'select_primary_risk_types',
  283     'determine_audience_mode',
  284 ]
  285
  286 patch_block = ''.join(
  287     f'import src.phase4.report_agent as _ra;'
  288     f'_ra.{name} = (lambda *a, **kw: (_ for _ in ()).throw('
  289     f'AssertionError("Phase4 must not call legacy {name} at runtime")));'
  290     for name in LEGACY_NAMES
  291 )
  292
  293 wrapper = f'''
  294 import sys, os
  295 sys.path.insert(0, {os.getcwd()!r})
  296 {patch_block}
  297 import runpy
  298 sys.argv = ['main.py', 'seeds/test8.txt']
  299 runpy.run_path('main.py', run_name='__main__')
  300 '''
  301
  302 def test_no_legacy_compute_at_runtime():
  303     result = subprocess.run(
  304         ['.venv/bin/python', '-c', wrapper],
  305         capture_output=True, text=True, timeout=120
  306     )
  307     assert result.returncode == 0, (
  308         f'Legacy compute function was called at runtime.\\n'
  309         f'stderr: {result.stderr[-2000:]}'
  310     )
  311 ```
