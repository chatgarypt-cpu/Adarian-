  - src/analysis/stance_analyzer.py
  - src/analysis/__init__.py
  - src/parser.py
  - src/phase4/report_narrative.py
  - src/phase4/report_agent.py
  - src/phase4/paths.py
  - src/whitebox/__init__.py
  - src/whitebox/run_meta.py
